# Copy to /opt/prosper-monitor/.env and fill in. Never commit the real file.
BASE_PATH=/prosper-monitor
PUBLIC_URL=https://mcp.pharosfdv.xyz/prosper-monitor
START_BLOCK=17515618
POLL_MS=2500
CONFIRMATIONS=2
RATE_LIMIT_PER_MINUTE=60

# Telegram bot (from @BotFather). Leave empty to disable the bot.
TELEGRAM_BOT_TOKEN=
# Usernames allowed to subscribe (without @), comma-separated.
TELEGRAM_ALLOWED_USERNAMES=daolog
TELEGRAM_ADMIN_CONTACT=@daolog
